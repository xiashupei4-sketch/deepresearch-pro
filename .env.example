# ============ LLM ============
# 留空则自动使用 Mock LLM（全流程可运行，无真实模型调用）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ============ Database ============
# 开发环境默认 SQLite；完整环境使用 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/deepresearch.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deepresearch

# ============ Cache ============
# 留空使用 InMemoryCache
REDIS_URL=

# ============ Vector DB ============
# 留空使用 FAISS / 内存实现
QDRANT_URL=

# ============ Search ============
# Web Search 工具选择: duckduckgo | serpapi | none
WEB_SEARCH_PROVIDER=duckduckgo
SERPAPI_KEY=

# ============ App ============
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
